# 코드가 실제로 읽는 환경변수 (2026-09 기준). .env로 복사해서 값을 채운다.
# 선택 항목은 빈 값으로 두지 말 것 — 줄을 지우면 기본값이 쓰인다.

# ── LLM (필수)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── 데이터 수집 (필수)
FRED_API_KEY=
BOK_ECOS_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
DART_API_KEY=
# KRX 로그인 — pykrx가 직접 읽는다
KRX_ID=
KRX_PW=

# ── 리포트 발행 (Notion 발행이 실패하면 data/reports/에 파일로 남는다)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ── 동작 옵션 (선택)
# legacy(기본) | python_sonnet
CHIEF_MODE=legacy
# 실행 1회 LLM 비용 상한(달러)
LLM_BUDGET_USD=5.0
# shadow(기본) | off — 그 밖의 값은 off로 처리된다
SHADOW_MODE=shadow
# 테스트용 DB 경로 변경
# MENTIONS_DB_PATH=data/mentions.db

# ── LangSmith 추적 (선택)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=Daily Stock Report Project
LANGCHAIN_ENDPOINT=
